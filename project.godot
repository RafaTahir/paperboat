; AFTER THE RAIN — Godot 4.6.3 stable, Compatibility, single-threaded web.
config_version=5

[application]
config/name="AFTER THE RAIN"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A small journey, after a tropical shower."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.51,0.63,0.60,1)
lights_and_shadows/directional_shadow/size=2048

[audio]
; Project setting: 0=Stream, 1=Sample. Player enum values are different.
general/default_playback_type.web=1

[physics]
common/physics_ticks_per_second=60
